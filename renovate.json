{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    "helpers:pinGitHubActionDigests",
    "group:all",
    "schedule:monthly"
  ],
  "minimumReleaseAge": "10 days",
  "internalChecksFilter": "strict",
  "automerge": true,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["* 0-3 1 * *"]
  },
  "vulnerabilityAlerts": {
    "minimumReleaseAge": null,
    "schedule": []
  }
}
